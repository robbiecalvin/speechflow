{
  "name": "speechflow",
  "version": "0.1.0",
  "private": true,
  "description": "SpeechFlow mobile apps and static web workspace",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "node scripts/build-web.cjs",
    "mobile:sync": "npm run build:web && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "android:debug": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "test:native": "node --test tests/native.test.cjs",
    "mobile:icons": "capacitor-assets generate --ios --android --assetPath native/assets --iconBackgroundColor '#f7f8f2' --iconBackgroundColorDark '#f7f8f2' --splashBackgroundColor '#f7f8f2' --splashBackgroundColorDark '#f7f8f2'",
    "android:bundle": "npm run mobile:sync && cd android && ./gradlew bundleRelease",
    "package:mobile": "npm run mobile:sync && python3 scripts/package-mobile.py"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "8.6.2",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "esbuild": "^0.27.0"
  }
}
